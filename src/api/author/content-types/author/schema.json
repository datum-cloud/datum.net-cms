{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author",
    "description": "Create authors for your content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": false
    },
    "name": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "bio": {
      "type": "text",
      "required": true
    },
    "helloBio": {
      "type": "text",
      "required": false
    },
    "deckBio": {
      "type": "text",
      "required": false
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "isTeam": {
      "type": "boolean",
      "default": false
    },
    "team": {
      "type": "enumeration",
      "enum": [
        "founders",
        "team"
      ]
    },
    "isCard": {
      "type": "boolean",
      "default": false
    },
    "cardCategories": {
      "type": "customField",
      "customField": "plugin::multiselect-field.multiselect-field",
      "required": false,
      "options": {
        "availableOptions": [
          "partnerships",
          "support",
          "pr_events",
          "fundraising"
        ],
        "delimiter": ","
      }
    },
    "location": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "social": {
      "type": "component",
      "repeatable": false,
      "component": "shared.social"
    },
    "tick": {
      "type": "text"
    },
    "surprising": {
      "type": "text"
    },
    "weekends": {
      "type": "text"
    },
    "calendly": {
      "type": "string",
      "regex": "^$|^https?:\\/\\/\\S+$"
    },
    "cardImages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "author"
    }
  }
}
