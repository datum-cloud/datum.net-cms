{
  "kind": "collectionType",
  "collectionName": "twins_blogs",
  "info": {
    "singularName": "twins-post",
    "pluralName": "twins-posts",
    "displayName": "Twins Post",
    "description": "Blog posts for the Twins in the Loop site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "tldr": {
      "type": "text"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "author": {
      "type": "enumeration",
      "enum": [
        "zac",
        "jacob"
      ],
      "required": true
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "post",
        "musing",
        "video",
        "podcast"
      ],
      "default": "post",
      "required": true
    },
    "topics": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic",
      "inversedBy": "twinsPosts"
    },
    "published": {
      "type": "date",
      "required": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "embedUrl": {
      "type": "string"
    },
    "canonical": {
      "type": "string"
    },
    "noindex": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "component": "twins-post.seo",
      "repeatable": false
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.media",
        "shared.quote",
        "shared.rich-text",
        "shared.slider"
      ]
    }
  }
}
